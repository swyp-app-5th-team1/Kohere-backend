APP_ENV=local
APP_PORT=8080
DATABASE_URL=
REDIS_URL=
API_BASE_URL=
JWT_SECRET=
API_KEY=
# 로컬 웹 프런트가 API와 다른 Origin일 때만 정확한 주소를 콤마로 나열한다.
# 비우면 같은 Origin과 Origin header가 없는 네이티브 앱만 허용하며 '*'는 사용할 수 없다.
APP_CHAT_WEBSOCKET_ALLOWED_ORIGINS=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# NCP Maps Geocoding(도로명 주소 검색, ADR-0042) — 네이버 클라우드 플랫폼 콘솔에서 발급한다.
# 위 검색 API(네이버 Developers)와 콘솔도 값도 다르다. 비우면 주소 검색만 502다.
NAVER_GEOCODE_CLIENT_ID=
NAVER_GEOCODE_CLIENT_SECRET=
# 카카오 로컬(인근 역 검색, ADR-0044) — 카카오 개발자 콘솔에서 앱 생성 후 로컬 API를 켜고 발급한다.
# 위 둘과 콘솔이 다르고 ID/Secret 쌍이 아니라 REST API 키 하나다. 비우면 역 검색만 502다.
KAKAO_REST_API_KEY=

# 앱스토어 심사 계정 고정 인증번호(이슈 #180) — 로컬 확인용. 운영에서는 활성화하지 않는다.
# 목록은 콤마 구분. tenant 계정은 이메일 인증만, landlord 계정은 SMS 인증만 고정 인증번호를 받고
# 반대 채널·미등록 값은 실제 발송 없이 거절된다. 한쪽 그룹만 채워도 되지만 그룹은 통째로 채워야 한다.
FIXED_VERIFICATION_ENABLED=false
FIXED_VERIFICATION_CODE=000000
FIXED_VERIFICATION_TENANT_GOOGLE_EMAILS=
FIXED_VERIFICATION_TENANT_EMAILS=
FIXED_VERIFICATION_LANDLORD_GOOGLE_EMAILS=
FIXED_VERIFICATION_LANDLORD_PHONES=
