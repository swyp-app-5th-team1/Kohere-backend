# environments/prod 변수 예시. 복사해서 terraform.tfvars 로 만들고 값을 채운다.
#   cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars 와 *.auto.tfvars 는 .gitignore 로 커밋에서 제외된다(시크릿 포함 가능).

aws_region = "ap-northeast-2"

# ----- 도메인 / TLS (필수 — HTTPS·커스텀 도메인 강제) -----
# 셋 다 필수. ACM 인증서(DNS 검증) + ALB HTTPS(80→443) + Route53 alias + CloudFront 별칭(us-east-1 ACM)을 만든다.
domain_name     = "api.kohere.app"
route53_zone_id = "Z0123456789ABCDEFGHIJ"
cdn_domain_name = "cdn.kohere.app"

# ----- S3 이미지 버킷 (필수 — S3는 전역 유일) -----
images_bucket_name = "kohere-prod-images"

# ----- CI/CD (GitHub Actions OIDC) -----
github_org           = "swyp-app-5th-team1"
github_repo          = "Kohere-backend"
github_deploy_branch = "main"

# ----- 외부 발급 시크릿/설정 (운영 전 반드시 채울 것 — 앱이 fail-fast) -----
# OIDC audience (우리 앱의 client ID)
google_client_id = ""  # sensitive
apple_client_id  = ""  # sensitive (MVP는 Google 우선, Apple은 여유 시)
# Apple 인가코드 흐름(ADR-0031) — 탈퇴 시 /auth/revoke. ECS는 SSM 값을 그대로 주입(멀티라인 PEM 보존).
apple_team_id = ""  # sensitive — Apple Developer Team ID
apple_key_id  = ""  # sensitive — Sign in with Apple .p8 Key ID
# .p8 개인키 전체(PKCS#8 PEM). heredoc로 실제 개행 그대로 붙여넣는다:
# apple_private_key = <<-EOT
# -----BEGIN PRIVATE KEY-----
# MIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHB...
# -----END PRIVATE KEY-----
# EOT
apple_private_key = ""  # sensitive

# 운영 SMTP (예: Amazon SES SMTP 자격증명). MVP 온보딩 이메일 인증에 필요.
smtp_host     = "email-smtp.ap-northeast-2.amazonaws.com"
smtp_port     = 587
smtp_username = ""  # sensitive
smtp_password = ""  # sensitive
mail_from     = "noreply@kohere.app"

# ----- 연락처 SMS (SOLAPI 국내 SMS API — 임대인 인증, ADR-0034) -----
# 기본 비활성(로깅 폴백). 켜려면 SOLAPI 콘솔에서 발신번호 등록·API 키 발급 후 채우고 solapi_enabled=true.
# solapi_enabled    = true
# solapi_from       = "01012345678"   # 사전 등록 발신번호(평문)
# solapi_api_key    = ""  # sensitive — SSM SecureString
# solapi_api_secret = ""  # sensitive — SSM SecureString

# ----- 사업자번호 검증 (비즈노 — 임대인 인증, ADR-0033) -----
# 기본 비활성(StubBusinessRegistryVerifier 폴백). 켜려면 비즈노 API 키 발급 후 채우고 bizno_enabled=true.
# bizno_enabled = true
# bizno_api_key = ""  # sensitive — SSM SecureString

# ----- 네이버 지역 검색 API (지도 장소 검색 — #160/#162) -----
# 지도 장소 검색(GET /api/v1/listings/places)에 필요. 미설정 시 SSM에 REPLACE_ME가 저장되고 장소 검색만 502(UPSTREAM_ERROR).
# 네이버 개발자센터에서 검색 API 사용 등록 후 Client ID/Secret 발급받아 채운다(둘 다 SSM SecureString):
# naver_search_client_id     = ""  # sensitive — SSM SecureString
# naver_search_client_secret = ""  # sensitive — SSM SecureString

# ----- 알람 (이메일·Discord 병행 가능 — 둘 다 채우면 양쪽으로 통보) -----
# alarm_email         = "ops@kohere.app"
# discord_webhook_url = "https://discord.com/api/webhooks/xxx/yyy"   # 채우면 알람을 Discord로 통보(SNS→Lambda, ADR-0027)  # sensitive

# ----- 규모 조정(선택) -----
# rds_multi_az   = true
# redis_replicas = 2
# desired_count  = 2
# autoscaling_max = 6
