# environments/dev 변수 예시. 복사해서 terraform.tfvars 로 만들고 값을 채운다.
#   cp terraform.tfvars.example terraform.tfvars
# *.tfvars 는 .gitignore 로 커밋에서 제외된다.

aws_region = "ap-northeast-2"

# ----- Google 채팅 자동 번역 (필수) -----
# 서비스 계정 JSON 키는 입력하지 않는다. EC2의 kohere-dev-host 역할을 Google WIF로 교환한다.
google_cloud_project_id                = "project-bdb9704d-3952-475b-a1c"
google_translation_service_account_email = "kohere@project-bdb9704d-3952-475b-a1c.iam.gserviceaccount.com"
# chat_translation_enabled = true

# ----- 앱 이미지 (필수) -----
# CI가 ECR에 push한 dev 태그 이미지.
app_image = "123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/kohere-backend:dev"

# ----- 도메인 / HTTPS (필수 — Caddy 자동 인증서 + CDN 강제) -----
# 셋 다 필수. domain_name → Caddy 자동 HTTPS(ADR-0022) + Route53 A(EIP), cdn_domain_name → CloudFront 별칭(us-east-1 ACM).
domain_name     = "dev.kohere.app"
route53_zone_id = "Z0123456789ABCDEFGHIJ"
cdn_domain_name = "cdn.dev.kohere.app"

# ----- S3 이미지 버킷 (필수 — S3는 전역 유일) -----
images_bucket_name = "kohere-dev-images"

# ----- 시크릿 (SSM Parameter Store SecureString 으로 저장됨 — SM 미사용·무료) -----
# JWT_SECRET·REFRESH_PEPPER·EMAIL_PEPPER 는 Terraform이 자동 생성한다. 아래만 채운다:
google_client_id = ""  # sensitive
apple_client_id  = ""  # sensitive
# Apple 인가코드 흐름(ADR-0031) — 탈퇴 시 /auth/revoke에 필요. 미설정이면 Apple 로그인만 미동작(다른 흐름 정상).
apple_team_id = ""  # sensitive — Apple Developer Team ID
apple_key_id  = ""  # sensitive — Sign in with Apple .p8 Key ID
# .p8 개인키 전체(PKCS#8 PEM). heredoc로 실제 개행 그대로 붙여넣는다 — refresh-env가 dev .env용으로 개행을 \n로 이스케이프한다.
# apple_private_key = <<-EOT
# -----BEGIN PRIVATE KEY-----
# MIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHB...
# -----END PRIVATE KEY-----
# EOT
apple_private_key = ""  # sensitive
# 실 SMTP (dev는 MailHog 없음 — 예: Amazon SES SMTP)
smtp_host     = "email-smtp.ap-northeast-2.amazonaws.com"
smtp_port     = 587
smtp_username = ""  # sensitive
smtp_password = ""  # sensitive
mail_from     = "noreply@kohere.app"

# ----- 연락처 SMS (SOLAPI 국내 SMS API — 임대인 인증, ADR-0034) -----
# 기본 비활성(로깅 폴백 — dev 콘솔 로그에 인증번호 출력). 켜려면 SOLAPI 발신번호 등록·API 키 발급 후:
# solapi_enabled    = true
# solapi_from       = "01012345678"   # 사전 등록 발신번호
# solapi_api_key    = ""  # sensitive — SSM SecureString
# solapi_api_secret = ""  # sensitive — SSM SecureString

# ----- 사업자번호 검증 (비즈노 — 임대인 인증, ADR-0033) -----
# 기본 비활성(StubBusinessRegistryVerifier 폴백). 켜려면 비즈노 API 키 발급 후 채우고 bizno_enabled=true.
# bizno_enabled = true
# bizno_api_key = ""  # sensitive — SSM SecureString

# ----- 네이버 지역 검색 API (지도 장소 검색 — #160/#162) -----
# 지도 장소 검색(GET /api/v1/listings/places)에 필요. 미설정 시 앱은 정상 기동하되 장소 검색만 502(UPSTREAM_ERROR).
# 네이버 개발자센터에서 검색 API 사용 등록 후 Client ID/Secret 발급받아 채운다(둘 다 SSM SecureString):
# naver_search_client_id     = ""  # sensitive — SSM SecureString
# naver_search_client_secret = ""  # sensitive — SSM SecureString

# ----- NCP Maps Geocoding (도로명 주소 검색 — #223) -----
# 매물 등록 폼의 주소 검색(GET /api/v1/listings/addresses)에 필요. 미설정 시 앱은 정상 기동하되 주소 검색만 502(UPSTREAM_ERROR).
# 네이버 클라우드 플랫폼 콘솔에서 Maps Application 등록 후 Client ID/Secret 발급받아 채운다 — 위 검색 API(네이버 Developers)와 다른 값이다:
# naver_geocode_client_id     = ""  # sensitive — SSM SecureString
# naver_geocode_client_secret = ""  # sensitive — SSM SecureString

# ----- 카카오 로컬 API (인근 역 검색 · 인근 대학 파생 — #224) -----
# 매물 등록 폼의 역 검색(GET /api/v1/listings/stations)과 등록 시 nearbyUniversityCodes 파생에 필요.
# 미설정 시 역 검색만 502(UPSTREAM_ERROR)이고 등록은 성공하되 인근 대학이 빈 배열이다.
# 카카오 개발자 콘솔에서 앱 생성 → 로컬 API 활성화 후 REST API 키를 발급받아 채운다 — 네이버·NCP와 다른 콘솔이다:
# kakao_rest_api_key = ""  # sensitive — SSM SecureString

# ----- 테스트 마스터 계정/로그인 (dev·local 전용, 운영 미사용) -----
# 기본 비활성. 우회 시크릿 TEST_LOGIN_SECRET 은 Terraform이 자동 생성한다(SSM SecureString) — 채우지 않는다.
# 이 한 토글이 마스터 계정 시드 + 우회 로그인을 함께 켠다. 공유 EC2 백도어라 필요할 때만 켠다:
# test_login_enabled = true   # 마스터 계정 시드 + idToken="master:<role>:<secret>" 우회 로그인 허용
# 반영: apply → (refresh-env.sh 최초 변경이면 EC2 재생성 1회) → 배포(gh workflow run deploy.yml, ADR-0024). 시크릿은 SSM에서 확인.

# ----- 앱스토어 심사 계정 고정 인증번호 (dev 전용, 운영 미사용 — #180) -----
# 심사자가 실제 SMS·이메일을 수신할 수 없어, 등록된 심사 계정에 한해 인증번호를 고정값으로 발급하고 외부 발송을 생략한다.
# 역할별로 채널이 갈린다 — tenant 계정은 이메일 인증만, landlord 계정은 SMS 인증만 고정 인증번호를 받고,
# 반대 채널이나 목록에 없는 값은 실제 발송 없이 422로 거절된다(심사자는 외부 수신을 못 하므로 흘려보내야 얻는 게 없다).
# 그룹은 통째로 비거나 통째로 채운다 — 반쪽이면 앱이 기동을 거부한다. 한쪽 트랙만 쓰는 것은 허용.
# 같은 Google 계정을 tenant·landlord 양쪽에 넣으면 역할이 모호해 기동이 막힌다.
# 심사 노트에는 아래 값(로그인 Google 계정 / 인증 대상 / 고정 인증번호)을 그대로 적어야 한다 — 다른 값을 입력하면 거절된다.
# 임대인 번호는 마스터 임대인 시드 번호(01000000000 — MasterAccountSeedRunner, test_login_enabled 로 함께 켜진다)와 달라야 한다.
# users.phone_number 에 UNIQUE(V23, #229)가 걸린 뒤로 같은 번호를 쓰면 심사자가 임대인 온보딩을 끝내지 못한다 —
# 중복 키로 실패하거나, 같은 번호 계정 병합(US-1-15)에 걸려 심사자 계정이 공용 마스터 계정으로 흡수된다.
# fixed_verification_enabled                = true
# fixed_verification_code                   = "000000"                    # sensitive — 자릿수는 app.email/phone.code-length(6)와 일치
# fixed_verification_tenant_google_emails   = "review-tenant@gmail.com"    # sensitive — 콤마 구분
# fixed_verification_tenant_emails          = "demo-tenant@example.com"    # sensitive — 콤마 구분
# fixed_verification_landlord_google_emails = "review-landlord@gmail.com"  # sensitive — 콤마 구분
# fixed_verification_landlord_phones        = "01099990000"                # sensitive — 콤마 구분 · 마스터 임대인 시드 번호와 겹치면 안 된다
# 반영: apply → (refresh-env.sh 최초 변경이면 EC2 재생성 1회) → 배포(gh workflow run deploy.yml, ADR-0024).
# 심사 종료 후 fixed_verification_enabled = false 로 되돌리고 apply → 배포한다.

# ----- DB 자격증명 (SSM SecureString) + 외부 접속 (dev 한정) -----
# 비우면 기본 "kohere". 외부 노출(db_ingress_cidrs) 시 반드시 강한 값으로 바꾼다.
# 변경 반영: 최초 init 후의 username·비번 변경은 배포 시 reconcile-db.sh가 live DB에 회전 적용한다(데이터 보존, ADR-0025).
# mysql_username      = "kohere"
# mysql_password      = ""  # sensitive — 앱 사용자 비번
# mysql_root_password = ""  # sensitive — root(외부 관리도구용)
# mongo_username      = "kohere"
# mongo_password      = ""  # sensitive — URL-safe 권장(URI 포함)
# DB 포트 외부 개방 CIDR. 빈 목록=미개방(앱 내부 접속만). 본인 IP/32 로 제한 권장:
# db_ingress_cidrs = ["203.0.113.7/32"]

# ----- 로그 반출 (ADR-0038 ⑥, 옵셔널) -----
# Log Group(/kohere/dev/app)·IAM 권한은 항상 만들어진다. 아래 토글은 "실제로 보낼지"만 결정한다.
# 기본 true — ADR-0038의 도입 게이트를 dev 호스트 실측으로 통과했다(available 656Mi > 300MB,
# 스왑 2Gi 중 29Mi만 사용). 여유 판단은 free가 아니라 available로 한다.
# user_data는 부팅 시에만 실행되므로 최초 반영에는 EC2 재생성 1회가 필요하다.
# 켠 뒤 확인: 메모리·스왑은 자동 수집되지 않으므로(EC2 기본 지표에 없고 Agent도 logs 전용) SSM 접속 후
# free -m 을 직접 본다. 스왑 사용량이 계속 오르면 압박 신호 — false로 되돌리거나 instance_type=t3.medium.
# enable_cloudwatch_agent = true
# log_retention_days      = 30          # 무기한 금지

# ----- 알람 / 규모 (옵셔널) -----
# discord_webhook_url = "https://discord.com/api/webhooks/xxx/yyy"   # 채우면 알람을 Discord로 통보(SNS→Lambda)
# instance_type    = "t3.small"         # x86 (ECR 이미지 amd64) · 2vCPU/2GB
# data_volume_size = 20
# ingress_cidrs    = ["0.0.0.0/0"]      # dev 편의상 개방. 사무실 IP 등으로 제한 권장

# ----- 시크릿 변경 반영 -----
# 위 값을 바꿔 apply 하면 SSM 파라미터가 갱신된다. 실행 중 앱 반영은 "배포"가 담당(prod ECS와 동일 모델) —
# 코드 변경 없이 시크릿만 바꿨다면 배포 워크플로를 돌려 반영한다: gh workflow run deploy.yml (ADR-0024).

# ----- CI/CD (GitHub Actions OIDC 배포 역할) -----
github_org           = "swyp-app-5th-team1"
github_repo          = "Kohere-backend"
github_deploy_branch = "release"
# apply 후 `terraform output github_deploy_role_arn` 값을 리포 Variables 의 AWS_DEPLOY_ROLE_ARN 에 설정.

# ----- 임대인 웹(SPA) 정적 서빙 · 프론트 CI/CD (#232) -----
# 프론트 빌드 산출물이 올라갈 비공개 버킷(전역 유일). 호스트가 인스턴스 롤로 내려받아 Caddy가 같은 도메인에서 서빙한다.
web_artifacts_bucket_name = "kohere-dev-web-artifacts"
# web_release_retention_days = 90   # 즉시·동일 롤백이 보장되는 창. 줄이면 초과 나이의 릴리스가 실제로 삭제된다
# 배포 역할의 신뢰 조건(sub)에 리터럴로 박힌다 — 실제 레포 이름이어야 한다(기본값 없음).
github_web_repo = "Kohere-web"
# github_web_deploy_branch = "release"
# apply 후 아래 셋을 프론트 리포 Variables 에 설정한다:
#   terraform output web_artifacts_bucket        → WEB_ARTIFACTS_BUCKET
#   terraform output github_web_deploy_role_arn  → AWS_DEPLOY_ROLE_ARN
#   terraform output ssm_deploy_web_document     → SSM_DEPLOY_WEB_DOCUMENT
# GitHub이 새 레포에 적용하는 immutable subject claim 때문에 sub 에 숫자 ID가 붙는다
#   (repo:<org>@<orgId>/<repo>@<repoId>:ref:...). 신뢰 정책이 옛 형식과 함께 둘 다 받도록 조립한다.
#   확인: gh api repos/<org>/<repo> --jq '{repo_id:.id, owner_id:.owner.id}'
github_org_id      = "289965197"
github_web_repo_id = "1330553011"
