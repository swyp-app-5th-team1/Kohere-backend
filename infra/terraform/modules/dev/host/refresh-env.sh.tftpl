#!/bin/bash
# SSM Parameter Store SecureString → /opt/kohere/.env. (설계: ADR-0024)
# 부팅(user_data)·배포(deploy.yml) 양쪽에서 호출 — 호출 시점의 Parameter Store 최신값을 .env로 다시 받는다.
# 주의: .env 갱신만으로는 실행 중 컨테이너에 반영되지 않는다. 적용엔 app 컨테이너 recreate가 필요(deploy가 --force-recreate).
set -euo pipefail
get() { aws ssm get-parameter --region ${aws_region} --name "$1" --with-decryption --query Parameter.Value --output text; }
# 옵션 시크릿: 미설정이면 secrets 모듈이 파라미터를 아예 안 만든다(빈 값 제외) → 없으면 빈 값으로.
get_opt() { aws ssm get-parameter --region ${aws_region} --name "$1" --with-decryption --query Parameter.Value --output text 2>/dev/null || echo ""; }
# 멀티라인 .p8 → 한 줄(개행을 리터럴 \n로 이스케이프). .env는 KEY=VALUE 한 줄이라 개행 보존 불가 → 앱이 \n를 복원(ADR-0031).
get_pem_opt() { aws ssm get-parameter --region ${aws_region} --name "$1" --with-decryption --query Parameter.Value --output text 2>/dev/null | sed ':a;N;$!ba;s/\n/\\n/g' || echo ""; }
umask 077
cat >/opt/kohere/.env <<EOF
JWT_SECRET=$(get "${ssm_prefix}/JWT_SECRET")
REFRESH_PEPPER=$(get "${ssm_prefix}/REFRESH_PEPPER")
EMAIL_PEPPER=$(get "${ssm_prefix}/EMAIL_PEPPER")
PHONE_PEPPER=$(get "${ssm_prefix}/PHONE_PEPPER")
GOOGLE_CLIENT_ID=$(get_opt "${ssm_prefix}/GOOGLE_CLIENT_ID")
APPLE_CLIENT_ID=$(get_opt "${ssm_prefix}/APPLE_CLIENT_ID")
APPLE_TEAM_ID=$(get_opt "${ssm_prefix}/APPLE_TEAM_ID")
APPLE_KEY_ID=$(get_opt "${ssm_prefix}/APPLE_KEY_ID")
APPLE_PRIVATE_KEY=$(get_pem_opt "${ssm_prefix}/APPLE_PRIVATE_KEY")
SPRING_MAIL_USERNAME=$(get_opt "${ssm_prefix}/SMTP_USERNAME")
SPRING_MAIL_PASSWORD=$(get_opt "${ssm_prefix}/SMTP_PASSWORD")
# 연락처 SMS(SOLAPI)·사업자번호(비즈노) API 키 — 옵션 시크릿(미설정이면 SSM에 없음 → 빈 값). enabled=true인데 비면 발송/검증 시 502.
SOLAPI_API_KEY=$(get_opt "${ssm_prefix}/SOLAPI_API_KEY")
SOLAPI_API_SECRET=$(get_opt "${ssm_prefix}/SOLAPI_API_SECRET")
BIZNO_API_KEY=$(get_opt "${ssm_prefix}/BIZNO_API_KEY")
# 네이버 지역 검색 API(지도 장소 검색, #160/#162) — 옵션 시크릿(미설정이면 SSM에 없음 → 빈 값). 비면 장소 검색 호출만 502(다른 기능 정상).
NAVER_SEARCH_CLIENT_ID=$(get_opt "${ssm_prefix}/NAVER_SEARCH_CLIENT_ID")
NAVER_SEARCH_CLIENT_SECRET=$(get_opt "${ssm_prefix}/NAVER_SEARCH_CLIENT_SECRET")
# NCP Maps Geocoding(도로명 주소 검색, #223) — 옵션 시크릿. 비면 주소 검색 호출만 502(다른 기능 정상).
NAVER_GEOCODE_CLIENT_ID=$(get_opt "${ssm_prefix}/NAVER_GEOCODE_CLIENT_ID")
NAVER_GEOCODE_CLIENT_SECRET=$(get_opt "${ssm_prefix}/NAVER_GEOCODE_CLIENT_SECRET")
# 카카오 로컬 API(인근 역 검색 · 인근 대학 파생, #224) — 옵션 시크릿. 비면 역 검색만 502이고 등록의 인근 대학이 빈 배열이다.
KAKAO_REST_API_KEY=$(get_opt "${ssm_prefix}/KAKAO_REST_API_KEY")
# 앱 런타임 토글(비밀 아닌 String, ADR-0024) — compose 대신 .env로 주입해 재배포만으로 반영. 미설정 시 빈 값 → 앱 기본(enabled=false).
SOLAPI_ENABLED=$(get_opt "${ssm_prefix}/SOLAPI_ENABLED")
SOLAPI_FROM=$(get_opt "${ssm_prefix}/SOLAPI_FROM")
BIZNO_ENABLED=$(get_opt "${ssm_prefix}/BIZNO_ENABLED")
# 임대인 웹(SPA) 오리진 — 비밀번호 재설정 링크 base URL(#272). 비밀이 아니지만 compose에 박지 않는다:
# compose는 부팅 1회 렌더라 도메인이 바뀌면 EC2 재생성이 필요하고, 이쪽은 재배포만으로 반영된다.
# 미설정이면 빈 값 → 앱이 계정 복구를 켠 채로는 기동을 거부한다(깨진 링크가 담긴 메일이 나가는 것보다 낫다).
APP_WEB_BASE_URL=$(get_opt "${ssm_prefix}/APP_WEB_BASE_URL")
# dev 테스트 마스터 로그인 기능(운영 미사용) — ENABLED 하나로 시드+우회 로그인을 켠다. SECRET은 자동 생성(항상 존재), 기본 off는 tfvars→apply→재배포로 반영(ADR-0024).
TEST_LOGIN_SECRET=$(get_opt "${ssm_prefix}/TEST_LOGIN_SECRET")
TEST_LOGIN_ENABLED=$(get_opt "${ssm_prefix}/TEST_LOGIN_ENABLED")
# 앱스토어 심사 계정 고정 인증번호(#180, 운영 미사용) — 심사 기간에만 ENABLED=true. 목록은 콤마 구분.
# 미설정이면 SSM에 없음 → 빈 값 → 앱 기본(enabled=false). ENABLED=true인데 코드·계정이 비면 앱이 기동을 거부한다.
FIXED_VERIFICATION_ENABLED=$(get_opt "${ssm_prefix}/FIXED_VERIFICATION_ENABLED")
FIXED_VERIFICATION_CODE=$(get_opt "${ssm_prefix}/FIXED_VERIFICATION_CODE")
FIXED_VERIFICATION_TENANT_GOOGLE_EMAILS=$(get_opt "${ssm_prefix}/FIXED_VERIFICATION_TENANT_GOOGLE_EMAILS")
FIXED_VERIFICATION_TENANT_EMAILS=$(get_opt "${ssm_prefix}/FIXED_VERIFICATION_TENANT_EMAILS")
FIXED_VERIFICATION_LANDLORD_GOOGLE_EMAILS=$(get_opt "${ssm_prefix}/FIXED_VERIFICATION_LANDLORD_GOOGLE_EMAILS")
FIXED_VERIFICATION_LANDLORD_PHONES=$(get_opt "${ssm_prefix}/FIXED_VERIFICATION_LANDLORD_PHONES")
MYSQL_PASSWORD=$(get "${ssm_prefix}/MYSQL_PASSWORD")
MYSQL_ROOT_PASSWORD=$(get "${ssm_prefix}/MYSQL_ROOT_PASSWORD")
MONGO_PASSWORD=$(get "${ssm_prefix}/MONGO_PASSWORD")
MYSQL_USER=${mysql_username}
MONGO_USERNAME=${mongo_username}
DB_NAME=${db_name}
EOF
