#!/bin/bash
# 기존 dev EC2에 Google WIF 설정과 번역용 compose 환경변수를 안전하게 반영한다.
# WIF JSON은 서비스 계정 개인키가 아니라 AWS 역할을 어디에서 읽을지 설명하는 공개 설정이다.
set -euo pipefail

KOHERE_DIR="/opt/kohere"
WIF_FILE="$KOHERE_DIR/google-wif-credentials.json"
COMPOSE_FILE="$KOHERE_DIR/docker-compose.yml"
COMPOSE_BACKUP="$KOHERE_DIR/docker-compose.yml.before-chat-translation"

mkdir -p "$KOHERE_DIR"

# base64를 쓰면 JSON과 YAML 안의 따옴표·개행이 셸에서 다시 해석되지 않는다.
printf '%s' '${google_wif_credentials_base64}' | base64 --decode >"$WIF_FILE"
chmod 0444 "$WIF_FILE"

# 검증 실패 시 즉시 이전 compose로 되돌릴 수 있도록 현재 파일을 한 번 백업한다.
if [ -f "$COMPOSE_FILE" ]; then
  cp "$COMPOSE_FILE" "$COMPOSE_BACKUP"
fi

printf '%s' '${compose_yml_base64}' | base64 --decode >"$COMPOSE_FILE"

cd "$KOHERE_DIR"
if ! docker compose config --quiet; then
  echo "ERROR: 새 docker-compose.yml 검증 실패 — 이전 파일로 복원합니다."
  if [ -f "$COMPOSE_BACKUP" ]; then
    mv "$COMPOSE_BACKUP" "$COMPOSE_FILE"
  fi
  exit 1
fi

# app 컨테이너만 다시 만들어 새 환경변수와 읽기 전용 WIF 파일 마운트를 적용한다.
# MySQL·MongoDB·Redis·Caddy는 재시작하지 않으므로 채팅 데이터와 웹 연결에는 영향이 없다.
if ! docker compose up -d --force-recreate app; then
  echo "ERROR: app 재생성 실패 — 이전 compose로 복원합니다."
  if [ -f "$COMPOSE_BACKUP" ]; then
    mv "$COMPOSE_BACKUP" "$COMPOSE_FILE"
    docker compose up -d --force-recreate app || true
  fi
  exit 1
fi
echo "Google WIF와 채팅 자동 번역 설정 반영 완료"
