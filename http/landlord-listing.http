  "facilities": { "heatingSystem": ["INDIVIDUAL"], "kitchen": ["INDUCTION"], "laundry": ["WASHER"], "livingAmenities": ["WIFI"], "securityFeatures": ["CCTV"], "commonSpaces": ["SHARED_KITCHEN"], "providedSupplies": ["BEDDING"] },
  "nearestTransit": { "type": "SUBWAY", "name": "신촌역", "walkMinutes": 7 },
  "nearbyFacilities": ["CONVENIENCE_STORE"],
  "description": "역세권 고시원입니다.",
  "extraNotes": "취사는 공용 주방만 가능합니다.",
